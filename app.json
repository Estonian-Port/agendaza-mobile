{
  "expo": {
    "name": "Agendaza",
    "slug": "Agendaza",
    "version": "0.1.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agendaza",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.estonianport.agendaza",
      "buildNumber": "4",
      "infoPlist": {
        "UIStatusBarStyle": "UIStatusBarStyleDefault"
      }
    },
    "android": {
      "package": "com.estonianport.agendaza",
      "versionCode": 4,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      "expo-asset",
      "./plugins/build.js",
      "./plugins/releaseSigning.js",
      "./plugins/iosXcodeConfig.js",
      [
        "expo-camera",
        {
          "cameraPermission": "Agendaza requiere acceso a la cámara."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}