{
  "name": "agendaza",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 expo start",
    "start:prod": "EXPO_NO_TELEMETRY=1 NODE_ENV=production expo start --no-dev",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "deps:fix": "expo install --fix",
    "android:prebuild": "expo prebuild --platform android",
    "android:prebuild:clean": "expo prebuild --platform android --clean",
    "android:aab": "cd android && NODE_ENV=production ./gradlew bundleRelease",
    "android:apk": "cd android && NODE_ENV=production ./gradlew assembleRelease",
    "android:clean": "cd android && ./gradlew clean"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "axios": "^1.21.0",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.18",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.12",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "formik": "^2.4.9",
    "lucide-react-native": "^0.544.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "expo-doctor": "^1.21.6",
    "typescript": "~6.0.3"
  }
}
